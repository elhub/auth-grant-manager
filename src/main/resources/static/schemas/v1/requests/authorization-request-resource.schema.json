{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorization Request Resource",
  "description": "Schema for returning an authorization request.",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "authorization-request-common.schema.json#/$defs/id"
        },
        "type": {
          "$ref": "authorization-request-common.schema.json#/$defs/type"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "requestType": {
              "$ref": "authorization-request-common.schema.json#/$defs/requestType"
            },
            "requestedScopes": {
              "$ref": "authorization-request-common.schema.json#/$defs/requestedScopes"
            },
            "externalReference": {
              "$ref": "authorization-request-common.schema.json#/$defs/externalReference"
            },
            "requestedGrantValidFrom": {
              "$ref": "authorization-request-common.schema.json#/$defs/requestedGrantValidFrom"
            },
            "requestedGrantValidTo": {
              "$ref": "authorization-request-common.schema.json#/$defs/requestedGrantValidTo"
            },
            "redirectUri": {
              "$ref": "authorization-request-common.schema.json#/$defs/redirectUri"
            },
            "status": {
              "$ref": "authorization-request-common.schema.json#/$defs/status"
            },
            "textReference": {
              "$ref": "authorization-request-common.schema.json#/$defs/textReference"
            },
            "textLanguage": {
              "$ref": "authorization-request-common.schema.json#/$defs/textLanguage"
            },
            "validFrom": {
              "$ref": "../elhub-common.schema.json#/$defs/validFrom",
              "description": "Time the request was created."
            },
            "validTo": {
              "$ref": "../elhub-common.schema.json#/$defs/validTo",
              "description": "Deadline for the request. The request must be approved or rejected before this time, after which it expires."
            },
            "createdAt": {
              "$ref": "../elhub-common.schema.json#/$defs/createdAt"
            },
            "updatedAt": {
              "$ref": "../elhub-common.schema.json#/$defs/updatedAt"
            }
          },
          "required": ["textReference"]
        },
        "meta": {
          "type": "object",
          "properties": {}
        },
        "relationships": {
          "type": "object",
          "properties": {
            "requestedBy": {
              "$ref": "../elhub-common.schema.json#/$defs/agentRelationship",
              "description": "The agent that created the request, typically the energy supplier. When the request is approved, this agent becomes grantedTo in the resulting authorization grant."
            },
            "requestedPrincipal": {
              "$ref": "../elhub-common.schema.json#/$defs/agentRelationship",
              "description": "The agent the authorization concerns, for example the owner of the metering point. When the request is approved, this agent becomes principal in the resulting authorization grant."
            },
            "requestedOf": {
              "$ref": "../elhub-common.schema.json#/$defs/agentRelationship",
              "description": "The agent asked to approve the request. When the request is approved, this agent becomes grantedBy in the resulting authorization grant."
            },
            "approvedBy": {
              "$ref": "../elhub-common.schema.json#/$defs/approvedByRelationship",
              "description": "The person who approved the request. This person becomes approvedBy in the resulting authorization grant."
            },
            "authorizationGrants": {
              "$ref": "../elhub-common.schema.json#/$defs/authorizationGrantRelationship"
            }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "self": {
              "type": "string",
              "format": "uri-reference",
              "description": "Link to this resource, relative to the API base URL."
            }
          }
        }
      }
    }
  }
}
