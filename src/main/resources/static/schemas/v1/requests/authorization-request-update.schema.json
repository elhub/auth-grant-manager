{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorization Request Update",
  "description": "Accept or reject an authorization request.",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["id", "type", "attributes"],
      "properties": {
        "id": {
          "$ref": "authorization-request-common.schema.json#/$defs/id"
        },
        "type": {
          "$ref": "authorization-request-common.schema.json#/$defs/type"
        },
        "attributes": {
          "type": "object",
          "required": ["status", "textLanguage"],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": ["Accepted", "Rejected"]
            },
            "textLanguage": {
              "$ref": "authorization-request-common.schema.json#/$defs/textLanguage"
            }
          }
        }
      }
    }
  }
}
