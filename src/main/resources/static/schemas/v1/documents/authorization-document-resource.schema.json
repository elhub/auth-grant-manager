{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorization Document Resource",
  "description": "Schema for returning an authorization document.",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "authorization-document-common.schema.json#/$defs/id"
        },
        "type": {
          "$ref": "authorization-document-common.schema.json#/$defs/type"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "documentType": {
              "$ref": "authorization-document-common.schema.json#/$defs/documentType"
            },
            "requestedScopes": {
              "$ref": "authorization-document-common.schema.json#/$defs/requestedScopes"
            },
            "externalReference": {
              "$ref": "authorization-document-common.schema.json#/$defs/externalReference"
            },
            "requestedGrantValidFrom": {
              "$ref": "authorization-document-common.schema.json#/$defs/requestedGrantValidFrom"
            },
            "requestedGrantValidTo": {
              "$ref": "authorization-document-common.schema.json#/$defs/requestedGrantValidTo"
            },
            "status": {
              "$ref": "authorization-document-common.schema.json#/$defs/status"
            },
            "validFrom": {
              "$ref": "../elhub-common.schema.json#/$defs/validFrom",
              "description": "Time the document was created."
            },
            "validTo": {
              "$ref": "../elhub-common.schema.json#/$defs/validTo",
              "description": "Deadline for the document. The document must be signed and submitted before this time, after which it expires."
            },
            "createdAt": {
              "$ref": "../elhub-common.schema.json#/$defs/createdAt"
            },
            "updatedAt": {
              "$ref": "../elhub-common.schema.json#/$defs/updatedAt"
            }
          }
        },
        "relationships": {
          "type": "object",
          "properties": {
            "requestedBy": {
              "$ref": "../elhub-common.schema.json#/$defs/agentRelationship",
              "description": "The agent that created the document, typically the energy supplier. When the document is signed, this agent becomes grantedTo in the resulting authorization grant."
            },
            "requestedPrincipal": {
              "$ref": "../elhub-common.schema.json#/$defs/agentRelationship",
              "description": "The agent the authorization concerns, for example the owner of the metering point. When the document is signed, this agent becomes principal in the resulting authorization grant."
            },
            "requestedOf": {
              "$ref": "../elhub-common.schema.json#/$defs/agentRelationship",
              "description": "The agent asked to sign the document. When the document is signed, this agent becomes grantedBy in the resulting authorization grant."
            },
            "approvedBy": {
              "$ref": "../elhub-common.schema.json#/$defs/approvedByRelationship",
              "description": "The person who signed the document. This person becomes approvedBy in the resulting authorization grant."
            },
            "authorizationGrants": {
              "$ref": "../elhub-common.schema.json#/$defs/authorizationGrantRelationship"
            }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "self": {
              "type": "string",
              "format": "uri-reference",
              "description": "Link to this resource, relative to the API base URL."
            },
            "file": {
              "type": "string",
              "format": "uri-reference",
              "description": "Link to the PDF of the document, relative to the API base URL. Download it, sign it, and submit it with PUT to the same link."
            }
          }
        }
      }
    }
  }
}
