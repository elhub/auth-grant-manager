{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorization Grant Resource",
  "description": "Schema for returning consumable and persistent authorization grants.",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "authorization-grant-common.schema.json#/$defs/id"
        },
        "type": {
          "$ref": "authorization-grant-common.schema.json#/$defs/type"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "status": {
              "$ref": "authorization-grant-common.schema.json#/$defs/status"
            },
            "scopes": {
              "$ref": "authorization-grant-common.schema.json#/$defs/scopes"
            },
            "validFrom": {
              "$ref": "../elhub-common.schema.json#/$defs/validFrom"
            },
            "validTo": {
              "$ref": "../elhub-common.schema.json#/$defs/validTo"
            },
            "createdAt": {
              "$ref": "../elhub-common.schema.json#/$defs/createdAt"
            },
            "updatedAt": {
              "$ref": "../elhub-common.schema.json#/$defs/updatedAt"
            }
          }
        },
        "relationships": {
          "type": "object",
          "properties": {
            "principal": {
              "$ref": "../elhub-common.schema.json#/$defs/agentRelationship"
            },
            "grantedBy": {
              "$ref": "../elhub-common.schema.json#/$defs/agentRelationship"
            },
            "grantedTo": {
              "$ref": "../elhub-common.schema.json#/$defs/agentRelationship"
            },
            "approvedBy": {
              "$ref": "../elhub-common.schema.json#/$defs/approvedByRelationship"
            },
            "source": {
              "$ref": "../elhub-common.schema.json#/$defs/authorizationSourceRelationship"
            }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "self": {
              "type": "string",
              "format": "uri-reference"
            }
          }
        }
      }
    }
  }
}
