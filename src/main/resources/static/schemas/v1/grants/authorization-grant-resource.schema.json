{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorization Grant Resource",
  "description": "Schema for returning consumable and persistent authorization grants.",
  "type": "object",
  "required": ["data", "links", "meta"],
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "id",
        "type",
        "attributes",
        "relationships",
        "links"
      ],
      "properties": {
        "id": {
          "$ref": "authorization-grant-common.schema.json#/$defs/id"
        },
        "type": {
          "$ref": "authorization-grant-common.schema.json#/$defs/type"
        },
        "attributes": {
          "type": "object",
          "required": [
            "status",
            "scopes",
            "validFrom",
            "createdAt",
            "updatedAt"
          ],
          "properties": {
            "status": {
              "$ref": "authorization-grant-common.schema.json#/$defs/status"
            },
            "scopes": {
              "$ref": "authorization-grant-common.schema.json#/$defs/scopes"
            },
            "validFrom": {
              "$ref": "../elhub-common.schema.json#/$defs/validFrom",
              "description": "Start of the period in which the grant is valid."
            },
            "validTo": {
              "$ref": "../elhub-common.schema.json#/$defs/validTo",
              "description": "End of the period in which the grant is valid. Omitted when the grant has no end date."
            },
            "createdAt": {
              "$ref": "../elhub-common.schema.json#/$defs/createdAt"
            },
            "updatedAt": {
              "$ref": "../elhub-common.schema.json#/$defs/updatedAt"
            }
          }
        },
        "relationships": {
          "type": "object",
          "required": [
            "principal",
            "grantedBy",
            "grantedTo",
            "approvedBy",
            "source"
          ],
          "properties": {
            "principal": {
              "$ref": "../elhub-common.schema.json#/$defs/agentRelationship",
              "description": "The agent the authorization concerns. This is the requestedPrincipal agent of the source document or request."
            },
            "grantedBy": {
              "$ref": "../elhub-common.schema.json#/$defs/agentRelationship",
              "description": "The agent that gave the authorization. This is the requestedOf agent of the source document or request."
            },
            "grantedTo": {
              "$ref": "../elhub-common.schema.json#/$defs/agentRelationship",
              "description": "The agent that holds the authorization. This is the requestedBy agent of the source document or request."
            },
            "approvedBy": {
              "$ref": "../elhub-common.schema.json#/$defs/approvedByRelationship",
              "description": "The person who signed the source document or approved the source request."
            },
            "source": {
              "$ref": "../elhub-common.schema.json#/$defs/authorizationSourceRelationship",
              "description": "The authorization document or request the grant was created from."
            }
          }
        },
        "links": {
          "type": "object",
          "required": ["self"],
          "properties": {
            "self": {
              "type": "string",
              "format": "uri-reference",
              "description": "Link to this resource, relative to the API base URL."
            }
          }
        }
      }
    },
    "links": {
      "$ref": "#/properties/data/properties/links"
    },
    "meta": {
      "$ref": "../../json-api-framework.schema.json#/$defs/topLevelMeta",
      "required": ["createdAt"]
    }
  }
}
