{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorization Grant Update",
  "description": "Schema for updating an authorization grant in the Elhub authorization manager.",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "required": ["id", "type", "attributes"],
      "properties": {
        "id": {
          "$ref": "authorization-grant-common.schema.json#/$defs/id"
        },
        "type": {
          "$ref": "authorization-grant-common.schema.json#/$defs/type"
        },
        "attributes": {
          "type": "object",
          "description": "The attributes of the authorization grant to  update.",
          "properties": {
            "status": {
              "type": "string",
              "const": "Exhausted",
              "description": "The only supported status transition for the v0 grant update endpoint."
            }
          },
          "required": ["status"]
        }
      }
    }
  },
  "required": ["data"]
}
